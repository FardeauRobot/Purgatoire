#!/usr/bin/env bash
# ADDClass - scaffold a C++ class (.hpp + .cpp) with the OCF skeleton.
# Usage: ADDClass <ClassName>
#
# If both ./include and ./src exist, the header goes into include/ and the
# source goes into src/. Otherwise, both files land at the current directory.

set -e

usage() {
    echo "Usage: ADDClass <ClassName>"
    exit 1
}

[ "$#" -eq 1 ] || usage

CLASS="$1"
CLASS_UPPER="$(printf '%s' "$CLASS" | tr '[:lower:]' '[:upper:]')"

if [ -d "./include" ] && [ -d "./src" ]; then
    HPP_DIR="./include"
    CPP_DIR="./src"
    LAYOUT="include/ + src/"
else
    HPP_DIR="."
    CPP_DIR="."
    LAYOUT="flat"
fi

HPP_PATH="$HPP_DIR/$CLASS.hpp"
CPP_PATH="$CPP_DIR/$CLASS.cpp"

if [ -e "$HPP_PATH" ]; then
    echo "ADDClass: '$HPP_PATH' already exists" >&2
    exit 1
fi
if [ -e "$CPP_PATH" ]; then
    echo "ADDClass: '$CPP_PATH' already exists" >&2
    exit 1
fi

cat > "$HPP_PATH" <<EOF
#ifndef ${CLASS_UPPER}_HPP
# define ${CLASS_UPPER}_HPP

#include <string>

class ${CLASS} {
    private:
        std::string _name;

    public:
        ${CLASS}(std::string name);
        ${CLASS}(const ${CLASS} &src);
        ${CLASS}& operator= (const ${CLASS} &other);
        ~${CLASS}();
};

#endif
EOF

cat > "$CPP_PATH" <<EOF
#include <iostream>
#include "${CLASS}.hpp"
#include "utils.hpp"

${CLASS}::${CLASS}(std::string name): _name(name) {
    std::cout << BOLD_CYAN << "${CLASS} Name constructor called" << endofline;
}

${CLASS}::${CLASS}(const ${CLASS} &src) {
    std::cout << BOLD_BLUE << "${CLASS} Copy constructor called" << endofline;
    *this = src;
}

${CLASS}& ${CLASS}::operator= (const ${CLASS} &other) {
    std::cout << BOLD_BLUE << "${CLASS} Copy assignment operator called" << endofline;
    if (this != &other)
        _name = other._name;
    return (*this);
}

${CLASS}::~${CLASS}() {
    std::cout << BOLD_RED << "${CLASS} Destructor called" << endofline;
}
EOF

echo "✓ class '$CLASS' created ($LAYOUT)"
echo "  $HPP_PATH"
echo "  $CPP_PATH"
